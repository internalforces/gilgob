---
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import FieldIndex from '../components/home/FieldIndex.astro';
import Hero from '../components/home/Hero.astro';
import RecentLearning from '../components/home/RecentLearning.astro';
import SignalPanel from '../components/home/SignalPanel.astro';
import ContributionCalendar from '../components/github/ContributionCalendar.astro';
import RecentActivity from '../components/github/RecentActivity.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { readContentIndex } from '../lib/content/index-store';
import { getPublicEntries } from '../lib/content/queries';
import { calculateContentStats, loadSkillSignal } from '../lib/content/stats';
import type { ContentIndex, ContentRecord } from '../lib/content/types';
import { getGitHubStats } from '../lib/github/fetch-github';

const entries = await getPublicEntries();
const publicIds = new Set(entries.map((entry) => entry.id));
let indexedEntries = new Map<string, { outgoing: string[] }>();
let publicRecords = new Map<string, ContentRecord>();
let connectionsAvailable = true;
let contentIndex: ContentIndex | null = null;

try {
  contentIndex = readContentIndex();
  const publicDocuments = contentIndex.documents.filter((entry) => publicIds.has(entry.id));
  publicRecords = new Map(publicDocuments.map((entry) => [entry.id, entry]));
  indexedEntries = new Map(publicDocuments
    .map((entry) => [entry.id, {
      outgoing: entry.outgoing.filter((target) => publicIds.has(target)),
    }]));
} catch {
  connectionsAvailable = false;
}

const statsEntries = entries.map((entry) => ({
  kind: entry.kind,
  category: entry.data.category,
  status: entry.data.status,
  outgoing: indexedEntries.get(entry.id)?.outgoing ?? [],
}));
const stats = calculateContentStats(statsEntries);
const skillSignal = await loadSkillSignal(statsEntries, contentIndex);
const activeExplorations = entries.filter((entry) => (
  entry.kind === 'explorations' && entry.data.status === 'active'
));
const recentLearning = entries.filter((entry) => entry.kind === 'logs');
const featuredProjects = entries.filter((entry) => (
  entry.kind === 'projects' && entry.data.featured
));
const projectConnections = Object.fromEntries(featuredProjects.map((entry) => {
  const project = publicRecords.get(entry.id);
  const connectionIds = project === undefined
    ? []
    : [...project.backlinks, ...project.outgoing, ...project.related];
  const connections = [...new Set(connectionIds)]
    .filter((id) => id !== entry.id)
    .map((id) => publicRecords.get(id))
    .filter((connection): connection is ContentRecord => connection !== undefined)
    .slice(0, 3)
    .map((connection) => ({
      kind: connection.kind,
      title: connection.title,
      url: connection.url,
    }));
  return [entry.id, connections];
}));
const githubBuildTime = new Date();
const githubStats = await getGitHubStats({
  token: process.env.GITHUB_TOKEN,
  now: () => githubBuildTime,
});
const githubFetchDate = githubStats ? new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'Asia/Seoul',
}).format(new Date(githubStats.fetchedAt)) : null;
---

<BaseLayout
  title="gilgob"
  description="internalforces가 지식, 탐구, 프로젝트와 학습 기록을 연결해 가꾸는 한국어 지식 아카이브입니다."
>
  <div class="home-dashboard site-container" data-home-dashboard>
    <Hero />
    <FeaturedProjects entries={featuredProjects} connectionsById={projectConnections} />
    <RecentLearning entries={recentLearning} />
    <FieldIndex entries={entries} />
    <SignalPanel
      activeExplorations={activeExplorations}
      stats={stats}
      skillSignal={skillSignal}
      connectionsAvailable={connectionsAvailable}
      generatedAt={contentIndex?.generatedAt ?? null}
    />

    <section
      class="github-activity"
      data-github-activity
      data-state={githubStats ? githubStats.stale ? 'stale' : 'ready' : 'empty'}
    >
      <details data-home-support="github">
        <summary class="github-activity__heading">
          <span class="github-activity__copy">
            <span class="github-activity__title" role="heading" aria-level="2">GitHub 활동</span>
            <span class="github-activity__description">지식 기록 밖에서 이어지는 공개 코드 활동입니다.</span>
          </span>
          <span class="github-activity__toggle">
            <span class="github-activity__toggle-open">활동 펼치기</span>
            <span class="github-activity__toggle-close">활동 접기</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="m7 9 5 5 5-5"></path>
            </svg>
          </span>
        </summary>

        <div class="github-activity__content">
          <div class="github-activity__actions">
            <a href="https://github.com/internalforces" target="_blank" rel="noreferrer">
              GitHub 프로필 보기 <span aria-hidden="true">↗</span>
            </a>
          </div>

          {githubStats ? (
            <>
              {githubStats.stale && (
                <p class="github-activity__stale" role="status">
                  마지막으로 확인된 활동 · {githubFetchDate}
                </p>
              )}
              <div class="github-activity__grid">
                <ContributionCalendar total={githubStats.total} weeks={githubStats.weeks} />
                <RecentActivity events={githubStats.events} referenceTime={githubBuildTime.toISOString()} />
              </div>
            </>
          ) : (
            <div class="github-activity__empty" role="status">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M4 18V9m5 9V5m5 13v-7m5 7V3"></path>
              </svg>
              <span>GitHub 통계를 불러오지 못했습니다.</span>
            </div>
          )}
        </div>
      </details>
    </section>

  </div>

  <script>
    import '../scripts/home-motion';
  </script>
</BaseLayout>

<style>
  .home-dashboard { width: min(calc(100% - 3rem), var(--content-max)); }
  .home-dashboard :global([data-home-card][data-home-focus-final]) { transition: none !important; }

  .github-activity {
    margin-block-start: 1rem;
    border: 1px solid color-mix(in srgb, var(--surface) 18%, transparent);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 90% 15%, color-mix(in srgb, var(--primary) 34%, transparent), transparent 20rem),
      var(--ink);
    color: var(--surface);
  }

  .github-activity__heading { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.5rem, 3vw, 2rem); cursor: pointer; list-style: none; }
  .github-activity__heading::-webkit-details-marker { display: none; }
  .github-activity__copy { display: grid; gap: 0.65rem; }
  .github-activity__title { font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 620; letter-spacing: -0.04em; line-height: 1.08; }
  .github-activity__description { display: block; max-width: 34rem; color: color-mix(in srgb, var(--surface) 66%, transparent); font-size: 0.9rem; }
  .github-activity__toggle { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.55rem; color: var(--surface); font-size: 0.82rem; font-weight: 650; white-space: nowrap; }
  .github-activity__toggle svg { transition: transform 180ms ease; }
  .github-activity__toggle-close { display: none; }
  .github-activity details[open] .github-activity__toggle-open { display: none; }
  .github-activity details[open] .github-activity__toggle-close { display: inline; }
  .github-activity details[open] .github-activity__toggle svg { transform: rotate(180deg); }
  .github-activity__content { padding: 0 clamp(1.5rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2rem); }
  .github-activity__actions { display: flex; justify-content: end; margin-block-end: 1rem; }
  .github-activity__actions a { color: var(--surface); font-size: 0.82rem; font-weight: 650; text-decoration: none; }

  .github-activity__grid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(18rem, 4fr); grid-auto-flow: dense; align-items: start; gap: 1rem; margin-block-start: clamp(2rem, 4vw, 3rem); }

  .github-activity__stale { width: fit-content; margin: 1.4rem 0 0; padding: 0.5rem 0.7rem; border-inline-start: 2px solid var(--signal); background: color-mix(in srgb, var(--surface) 8%, transparent); color: color-mix(in srgb, var(--surface) 72%, transparent); font-size: 0.72rem; }

  .github-activity__empty {
    display: flex;
    min-height: 8rem;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-block-start: 2rem;
    padding: 1rem 1.25rem;
    border: 1px dashed color-mix(in srgb, var(--surface) 28%, transparent);
    border-radius: 0.75rem;
    color: color-mix(in srgb, var(--surface) 75%, transparent);
    font-size: 0.82rem;
  }

  @media (max-width: 52rem) {
    .github-activity__heading { align-items: start; flex-direction: column; }
    .github-activity__toggle { width: 100%; justify-content: space-between; }
    .github-activity__grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 45rem) {
    .home-dashboard { width: min(calc(100% - 2rem), var(--content-max)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .github-activity__toggle svg { transition: none; }
  }
</style>
