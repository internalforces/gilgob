---
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import FieldIndex from '../components/home/FieldIndex.astro';
import Hero from '../components/home/Hero.astro';
import RecentLearning from '../components/home/RecentLearning.astro';
import SignalPanel from '../components/home/SignalPanel.astro';
import { withBase } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { readContentIndex } from '../lib/content/index-store';
import { getPublicEntries } from '../lib/content/queries';
import { calculateContentStats, loadSkillSignal } from '../lib/content/stats';
import type { ContentIndex } from '../lib/content/types';

const entries = await getPublicEntries();
const publicIds = new Set(entries.map((entry) => entry.id));
let indexedEntries = new Map<string, { outgoing: string[] }>();
let connectionsAvailable = true;
let contentIndex: ContentIndex | null = null;

try {
  contentIndex = readContentIndex();
  indexedEntries = new Map(contentIndex.documents
    .filter((entry) => publicIds.has(entry.id))
    .map((entry) => [entry.id, {
      outgoing: entry.outgoing.filter((target) => publicIds.has(target)),
    }]));
} catch {
  connectionsAvailable = false;
}

const statsEntries = entries.map((entry) => ({
  kind: entry.kind,
  category: entry.data.category,
  status: entry.data.status,
  outgoing: indexedEntries.get(entry.id)?.outgoing ?? [],
}));
const stats = calculateContentStats(statsEntries);
const skillSignal = await loadSkillSignal(statsEntries, contentIndex);
const activeExplorations = entries.filter((entry) => (
  entry.kind === 'explorations' && entry.data.status === 'active'
));
const recentLearning = entries.filter((entry) => entry.kind === 'logs');
const featuredProjects = entries.filter((entry) => (
  entry.kind === 'projects' && entry.data.featured
));
---

<BaseLayout
  title="gilgob"
  description="internalforces가 지식, 탐구, 프로젝트와 학습 기록을 연결해 가꾸는 한국어 디지털 가든입니다."
>
  <div class="home-dashboard site-container" data-home-dashboard>
    <Hero />
    <FieldIndex entries={entries} />
    <SignalPanel
      activeExplorations={activeExplorations}
      stats={stats}
      skillSignal={skillSignal}
      connectionsAvailable={connectionsAvailable}
    />
    <RecentLearning entries={recentLearning} />
    <FeaturedProjects entries={featuredProjects} />

    <section class="github-slot" aria-labelledby="github-activity-title" data-github-activity-slot data-state="empty">
      <div>
        <h2 id="github-activity-title">GitHub 활동</h2>
        <p>코드에서 이어지는 최근 공개 활동을 이곳에 연결합니다.</p>
      </div>
      <div class="github-slot__empty" role="status" aria-live="polite">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4 18V9m5 9V5m5 13v-7m5 7V3"></path>
        </svg>
        <span>GitHub 활동 데이터가 아직 연결되지 않았습니다.</span>
      </div>
      <a href="https://github.com/internalforces" target="_blank" rel="noreferrer">
        GitHub 프로필 보기 <span aria-hidden="true">↗</span>
      </a>
    </section>

    <nav class="home-quick-links" aria-label="홈 하단 바로가기">
      <a href={withBase('/knowledge/')}>정리된 지식</a>
      <a href={withBase('/projects/')}>진행한 프로젝트</a>
    </nav>
  </div>

  <script>
    import '../scripts/home-motion';
  </script>
</BaseLayout>

<style>
  .home-dashboard { width: min(calc(100% - 3rem), var(--content-max)); }
  .home-dashboard :global([data-home-card][data-home-focus-final]) { transition: none !important; }

  .github-slot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-block-start: clamp(7rem, 13vw, 11rem);
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid color-mix(in srgb, var(--surface) 18%, transparent);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 90% 15%, color-mix(in srgb, var(--primary) 34%, transparent), transparent 20rem),
      var(--ink);
    color: var(--surface);
  }

  .github-slot h2 { margin: 0; font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 620; letter-spacing: -0.04em; }
  .github-slot p { max-width: 30rem; margin: 0.65rem 0 0; color: color-mix(in srgb, var(--surface) 66%, transparent); font-size: 0.9rem; }

  .github-slot__empty {
    display: flex;
    min-height: 5rem;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.25rem;
    border: 1px dashed color-mix(in srgb, var(--surface) 28%, transparent);
    border-radius: 0.75rem;
    color: color-mix(in srgb, var(--surface) 75%, transparent);
    font-size: 0.82rem;
  }

  .github-slot > a { color: var(--surface); font-size: 0.86rem; font-weight: 650; text-decoration: none; white-space: nowrap; }

  .home-quick-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block-start: clamp(4rem, 8vw, 7rem);
  }

  .home-quick-links a {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-block: 1px solid var(--line);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 620;
    text-decoration: none;
    transition: color 180ms ease, padding-inline 180ms ease;
  }

  .home-quick-links a::after { color: var(--primary); content: '→'; }
  .home-quick-links a:hover { padding-inline: 2.15rem 1.85rem; color: var(--primary); }

  @media (max-width: 52rem) {
    .github-slot { grid-template-columns: minmax(0, 1fr); }
    .github-slot > a { justify-self: start; }
  }

  @media (max-width: 45rem) {
    .home-dashboard { width: min(calc(100% - 2rem), var(--content-max)); }
    .home-quick-links { grid-template-columns: minmax(0, 1fr); }
  }
</style>
