---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { isProductionBuild } from '../../lib/content/queries';

export const getStaticPaths = (async () => {
  const entries = await getCollection('portfolio');
  const entryByShareId = new Map<string, string>();

  for (const entry of entries) {
    const existingEntryId = entryByShareId.get(entry.data.shareId);
    if (existingEntryId) {
      throw new Error(
        `[portfolio] Duplicate portfolio shareId "${entry.data.shareId}" in "${existingEntryId}" and "${entry.id}".`,
      );
    }
    entryByShareId.set(entry.data.shareId, entry.id);
  }

  return entries
    .filter((entry) => !isProductionBuild() || !entry.data.draft)
    .map((entry) => ({
      params: { shareId: entry.data.shareId },
      props: { entry },
    }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PortfolioLayout entry={entry}><Content /></PortfolioLayout>
