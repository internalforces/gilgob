---
import type { CollectionEntry } from 'astro:content';
import PortfolioEvidence from '../components/portfolio/PortfolioEvidence.astro';
import PortfolioOverview from '../components/portfolio/PortfolioOverview.astro';
import PortfolioToolbar from '../components/portfolio/PortfolioToolbar.astro';
import { PORTFOLIO_PROFILE } from '../config/portfolio';
import { withBase } from '../config/site';
import '@fontsource/noto-sans-kr/korean-400.css';
import '@fontsource/noto-sans-kr/korean-500.css';
import '@fontsource/noto-sans-kr/korean-600.css';
import '@fontsource/noto-sans-kr/korean-700.css';
import '../styles/portfolio.css';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const actionLinks = [
  { href: withBase(`/projects/${entry.data.project}/`), label: '기술 문서' },
  entry.data.repository && { href: entry.data.repository, label: 'GitHub 저장소' },
  entry.data.package && { href: entry.data.package, label: '패키지 보기' },
  entry.data.demo && { href: entry.data.demo, label: '데모 보기' },
].filter((link): link is { href: string; label: string } => Boolean(link));
const pdfRequiredText = Array.from(new Set([
  PORTFOLIO_PROFILE.name,
  PORTFOLIO_PROFILE.email,
  entry.data.title,
  entry.data.headline,
  ...entry.data.metrics.map((metric) => metric.value),
  ...entry.data.decisions.map((decision) => decision.implementation),
]));
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  robots="noindex, nofollow, noarchive, nosnippet"
  searchable={false}
  siteChrome={false}
>
  <article
    class="portfolio-page"
    data-portfolio-project={entry.data.project}
    data-portfolio-pdf-required-text={JSON.stringify(pdfRequiredText)}
  >
    <PortfolioToolbar />
    <div class="portfolio-print-sheet">
      <PortfolioOverview entry={entry} />
      <PortfolioEvidence entry={entry} />
    </div>
    <section class="portfolio-detail" aria-labelledby="portfolio-detail-title">
      <h2 id="portfolio-detail-title">설계·구현 상세</h2>
      <div class="prose"><slot /></div>
      <nav class="portfolio-actions" aria-label="프로젝트 링크">
        {actionLinks.map((link, index) => (
          <a
            href={link.href}
            target={index === 0 ? undefined : '_blank'}
            rel={index === 0 ? undefined : 'noreferrer'}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </section>
    <aside class="portfolio-contact" aria-labelledby="portfolio-contact-title">
      <h2 id="portfolio-contact-title">연락처</h2>
      <a href={`mailto:${PORTFOLIO_PROFILE.email}`}>{PORTFOLIO_PROFILE.email}</a>
      <a href={PORTFOLIO_PROFILE.github}>GitHub</a>
    </aside>
  </article>
</BaseLayout>
