---
import { withBase } from '../../config/site';
import type { NormalizedEntry } from '../../lib/content/queries';
import type { ContentStats, SkillSignal } from '../../lib/content/stats';

interface Props {
  activeExplorations: NormalizedEntry[];
  stats: ContentStats;
  skillSignal: SkillSignal;
  connectionsAvailable?: boolean;
  generatedAt?: string | null;
}

const {
  activeExplorations,
  stats,
  skillSignal,
  connectionsAvailable = true,
  generatedAt = null,
} = Astro.props;
const skillTotal = skillSignal.mastered + skillSignal.learning + skillSignal.planned;
const skillProgressLabel = skillSignal.source === 'skills'
  ? '스킬 트리 기준 전체 스킬 진척도'
  : '공개 지식 문서 상태 기반 스킬 신호';
const generatedDate = generatedAt === null ? null : new Date(generatedAt);
const generatedLabel = generatedDate === null ? null : new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Seoul',
}).format(generatedDate);
const skillSourceNote = skillSignal.source === 'skills'
  ? '스킬 파일에 명시된 습득·학습 중·예정 상태를 합산합니다.'
  : '스킬 파일이 없을 때 공개 지식 문서의 상태를 대신 합산합니다.';
---

<details class="signals home-section" data-home-support="signals">
  <summary class="signals__heading">
    <span class="signals__copy">
      <span class="signals__title" role="heading" aria-level="2">작업 현황</span>
      <span class="signals__description">탐구와 배움의 상태, 공개 기록의 규모를 필요할 때 확인합니다.</span>
    </span>
    <span class="signals__toggle">
      <span class="signals__toggle-open">현황 펼치기</span>
      <span class="signals__toggle-close">현황 접기</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="m7 9 5 5 5-5"></path>
      </svg>
    </span>
  </summary>

  <div class="signals__content">
    {generatedDate !== null && generatedLabel !== null && (
      <p class="signals__provenance" data-signal-provenance>
        공개 기록 집계 · <time datetime={generatedDate.toISOString()}>{generatedLabel}</time>
      </p>
    )}

    <div class="signals__grid">
      <article class="signal-card">
      <header class="signal-card__header">
        <h3>지금 탐구하는 질문</h3>
        <span>공개 탐구</span>
      </header>
      {activeExplorations.length > 0 ? (
        <ul class="signal-card__explorations">
          {activeExplorations.slice(0, 3).map((entry) => (
            <li>
              <a href={withBase(entry.url)}>{entry.data.title}</a>
              <p>{entry.data.description}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="signal-card__empty">현재 공개된 활성 탐구가 없습니다.</p>
      )}
      <a class="signal-card__link" href={withBase('/explorations/')}>
        모든 탐구 보기 <span aria-hidden="true">→</span>
      </a>
      </article>

      <article class="signal-card signal-card--skill">
      <header class="signal-card__header">
        <h3>배움의 현재 상태</h3>
        <span>{skillSignal.source === 'skills' ? '스킬 트리 기준' : '지식 문서 상태 기준'}</span>
      </header>
      {skillTotal > 0 ? (
        <>
          <p class="signal-card__summary">
            전체 {skillTotal.toLocaleString('ko-KR')}개 중 {skillSignal.mastered.toLocaleString('ko-KR')}개를 익혔고,
            {' '}{skillSignal.learning.toLocaleString('ko-KR')}개를 배우는 중입니다.
          </p>
          <div
            class="signal-card__progress"
            role="progressbar"
            aria-label={skillProgressLabel}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={skillSignal.percent}
            data-progress-bar
          >
            <span style={`--progress: ${skillSignal.percent}%`}></span>
          </div>
          <dl class="signal-card__status-list">
            <div><dt>습득</dt><dd>{skillSignal.mastered}</dd></div>
            <div><dt>학습 중</dt><dd>{skillSignal.learning}</dd></div>
            <div><dt>예정</dt><dd>{skillSignal.planned}</dd></div>
          </dl>
        </>
      ) : (
        <p class="signal-card__empty">아직 스킬 신호로 계산할 공개 지식 문서가 없습니다.</p>
      )}
      {skillTotal > 0 && <p class="signal-card__note">{skillSourceNote}</p>}
      </article>

      <article class="signal-card signal-card--growth">
      <header class="signal-card__header">
        <h3>공개 기록 규모</h3>
        <span>지금 볼 수 있는 기록</span>
      </header>
      <div class="signal-card__growth-layout">
        <dl class="signal-card__counts">
          <div><dt>문서</dt><dd>{stats.documents.toLocaleString('ko-KR')}</dd></div>
          <div>
            <dt>연결</dt>
            {connectionsAvailable
              ? <dd>{stats.connections.toLocaleString('ko-KR')}</dd>
              : <dd class="signal-card__unavailable">확인 불가</dd>}
          </div>
          <div><dt>분야</dt><dd>{stats.categories.toLocaleString('ko-KR')}</dd></div>
        </dl>
      </div>
      <p class="signal-card__note">문서와 그 사이의 연결, 다루는 분야를 공개 기록에서 셉니다.</p>
      </article>
    </div>
  </div>
</details>

<style>
  .home-section { margin-block-start: clamp(5rem, 9vw, 7.5rem); }

  .signals { border-block: 1px solid var(--line); }
  .signals__heading { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: clamp(1.5rem, 3vw, 2rem); cursor: pointer; list-style: none; }
  .signals__heading::-webkit-details-marker { display: none; }

  .signals__copy { display: grid; gap: 0.8rem; }
  .signals__title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .signals__description {
    display: block;
    max-width: 42rem;
    color: var(--muted);
  }
  .signals__toggle { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.55rem; color: var(--primary); font-size: 0.82rem; font-weight: 650; white-space: nowrap; }
  .signals__toggle svg { transition: transform 180ms ease; }
  .signals__toggle-close { display: none; }
  .signals[open] .signals__toggle-open { display: none; }
  .signals[open] .signals__toggle-close { display: inline; }
  .signals[open] .signals__toggle svg { transform: rotate(180deg); }
  .signals__content { padding-block: 0 clamp(2rem, 4vw, 3.5rem); }
  .signals__provenance { margin: 0 0 1rem; color: var(--muted); font-size: 0.72rem; }

  .signals__grid {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .signal-card {
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .signal-card--growth {
    overflow: hidden;
    background:
      radial-gradient(circle at 100% 0, color-mix(in srgb, var(--primary) 10%, transparent), transparent 15rem),
      var(--surface);
  }

  .signal-card__header {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 2rem;
  }

  .signal-card__header h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 660;
  }

  .signal-card__header > span:not(.signal-card__dot) {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .signal-card__explorations {
    display: grid;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signal-card__explorations li + li { padding-block-start: 1.35rem; border-block-start: 1px solid var(--line); }
  .signal-card__explorations a { font-size: 1.18rem; font-weight: 620; letter-spacing: -0.025em; text-decoration: none; }
  .signal-card__explorations a:hover { color: var(--primary); }
  .signal-card__explorations p { margin: 0.55rem 0 0; color: var(--muted); font-size: 0.88rem; line-height: 1.65; }

  .signal-card__link {
    margin-block-start: auto;
    padding-block-start: 2rem;
    color: var(--primary);
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
  }

  .signal-card__summary { max-width: 28rem; margin: 0 0 1.4rem; font-size: clamp(1.25rem, 2.2vw, 1.65rem); font-weight: 610; letter-spacing: -0.025em; line-height: 1.45; }

  .signal-card__progress {
    height: 0.45rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--line) 80%, transparent);
  }

  .signal-card__progress span {
    display: block;
    width: var(--progress);
    height: 100%;
    border-radius: inherit;
    background: var(--signal);
    transform-origin: left;
  }

  .signal-card__status-list,
  .signal-card__counts {
    margin: 1.5rem 0 0;
  }

  .signal-card__status-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .signal-card__status-list div { display: grid; gap: 0.2rem; }
  .signal-card__status-list dt,
  .signal-card__counts dt { color: var(--muted); font-size: 0.75rem; }
  .signal-card__status-list dd,
  .signal-card__counts dd { margin: 0; font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-weight: 650; }

  .signal-card__growth-layout { display: grid; align-items: center; }

  .signal-card__counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .signal-card__counts div { display: grid; gap: 0.15rem; }
  .signal-card__counts dd { font-size: 1.75rem; }
  .signal-card__counts .signal-card__unavailable { font-family: inherit; font-size: 0.78rem; font-weight: 560; }

  .signal-card__note,
  .signal-card__empty {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .signal-card__note { margin: auto 0 0; padding-block-start: 1.5rem; }
  .signal-card__empty { margin: 0; }

  @media (max-width: 64rem) {
    .signals__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .signal-card--growth { grid-column: 1 / -1; min-height: 22rem; }
  }

  @media (max-width: 42rem) {
    .signals__heading { align-items: start; flex-direction: column; }
    .signals__toggle { width: 100%; justify-content: space-between; }
    .signals__grid { grid-template-columns: minmax(0, 1fr); }
    .signal-card--growth { grid-column: auto; }
    .signal-card { min-height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .signals__toggle svg { transition: none; }
  }
</style>
