---
import { withBase } from '../../config/site';
import type { NormalizedEntry } from '../../lib/content/queries';
import { categoryLabel } from '../../lib/content/taxonomy';

interface Props {
  entries: NormalizedEntry[];
}

const { entries } = Astro.props;
const statusLabels: Record<string, string> = {
  idea: '아이디어',
  building: '구축 중',
  maintained: '유지 중',
  archived: '보관',
};
---

<section class="featured-projects home-section" aria-labelledby="featured-projects-title">
  <header class="featured-projects__heading">
    <div>
      <h2 id="featured-projects-title">주요 프로젝트</h2>
      <p>배운 것을 실제 시스템으로 옮기며 남긴 선택과 다음 질문입니다.</p>
    </div>
    <a href={withBase('/projects/')}>프로젝트 보기 <span aria-hidden="true">→</span></a>
  </header>

  {entries.length > 0 ? (
    <div class="featured-projects__grid">
      {entries.map((entry) => (
        <article class="project-card" data-home-card>
          <div class="project-card__visual" aria-hidden="true" data-home-visual>
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="project-card__content">
            <div class="project-card__meta">
              <span>{entry.data.status ? statusLabels[entry.data.status] ?? '상태 미정' : '상태 미정'}</span>
              <span>{categoryLabel(entry.data.category)}</span>
            </div>
            <h3><a href={withBase(entry.url)}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
            <ul aria-label="태그">
              {entry.data.tags.map((tag) => <li>#{tag}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="featured-projects__empty">아직 공개된 주요 프로젝트가 없습니다.</p>
  )}
</section>

<style>
  .home-section { padding-block-start: clamp(7rem, 13vw, 11rem); }
  .featured-projects__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block-end: clamp(2rem, 4vw, 3.5rem); }
  .featured-projects__heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 620; letter-spacing: -0.045em; line-height: 1.08; }
  .featured-projects__heading p { max-width: 40rem; margin: 0.8rem 0 0; color: var(--muted); }
  .featured-projects__heading > a { color: var(--primary); font-size: 0.9rem; font-weight: 650; text-decoration: none; white-space: nowrap; }

  .featured-projects__grid { display: grid; grid-auto-flow: dense; gap: 1rem; }

  .project-card {
    display: grid;
    min-height: 27rem;
    grid-template-columns: minmax(16rem, 5fr) minmax(0, 7fr);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .project-card__visual {
    position: relative;
    min-height: 20rem;
    overflow: hidden;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--primary) 17%, transparent), transparent 55%),
      var(--ink);
  }

  .project-card__visual::before,
  .project-card__visual::after {
    position: absolute;
    inset: 12%;
    border: 1px solid color-mix(in srgb, var(--surface) 22%, transparent);
    border-radius: 50%;
    content: '';
  }

  .project-card__visual::after { inset: 28%; }
  .project-card__visual span { position: absolute; width: 0.65rem; height: 0.65rem; border: 2px solid var(--ink); border-radius: 50%; background: var(--signal); }
  .project-card__visual span:nth-child(1) { inset-block-start: 24%; inset-inline-start: 60%; }
  .project-card__visual span:nth-child(2) { inset-block-start: 66%; inset-inline-start: 28%; background: var(--primary); }
  .project-card__visual span:nth-child(3) { inset-block-start: 56%; inset-inline-start: 72%; }
  .project-card__visual span:nth-child(4) { inset-block-start: 38%; inset-inline-start: 38%; background: var(--surface); }

  .project-card__content { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 6vw, 5rem); }
  .project-card__meta { display: flex; gap: 1rem; color: var(--primary); font-size: 0.75rem; font-weight: 650; }
  .project-card h3 { margin: 1.25rem 0 0; font-size: clamp(2rem, 5vw, 4.25rem); font-weight: 620; letter-spacing: -0.055em; line-height: 1; }
  .project-card h3 a { text-decoration: none; }
  .project-card h3 a:hover { color: var(--primary); }
  .project-card p { max-width: 38rem; margin: 1.5rem 0 0; color: var(--muted); font-size: 1rem; }
  .project-card ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 2rem 0 0; padding: 0; color: var(--muted); font-size: 0.78rem; list-style: none; }
  .featured-projects__empty { padding: 2rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--muted); }

  @media (max-width: 48rem) {
    .featured-projects__heading { align-items: start; flex-direction: column; }
    .project-card { grid-template-columns: minmax(0, 1fr); }
    .project-card__visual { min-height: 15rem; }
  }
</style>
