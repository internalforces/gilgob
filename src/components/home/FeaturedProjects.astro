---
import { withBase } from '../../config/site';
import type { NormalizedEntry } from '../../lib/content/queries';
import type { ContentKind } from '../../lib/content/types';
import { categoryLabel } from '../../lib/content/taxonomy';

export interface ProjectConnection {
  kind: ContentKind;
  title: string;
  url: string;
}

interface Props {
  entries: NormalizedEntry[];
  connectionsById?: Record<string, ProjectConnection[]>;
}

const { entries, connectionsById = {} } = Astro.props;
const statusLabels: Record<string, string> = {
  idea: '아이디어',
  building: '구축 중',
  maintained: '유지 중',
  archived: '보관',
};
const kindLabels: Record<ContentKind, string> = {
  knowledge: '지식',
  explorations: '탐구',
  projects: '프로젝트',
  logs: '학습 기록',
};
---

<section class="featured-projects home-section" aria-labelledby="featured-projects-title">
  <header class="featured-projects__heading">
    <div>
      <h2 id="featured-projects-title">하나의 작업에서 시작하기</h2>
      <p>프로젝트를 중심에 두고, 실제로 연결된 질문과 지식을 이어 읽습니다.</p>
    </div>
    <a href={withBase('/projects/')}>모든 프로젝트 보기 <span aria-hidden="true">→</span></a>
  </header>

  {entries.length > 0 ? (
    <div class="featured-projects__grid">
      {entries.map((entry) => (
        <article class="project-card" data-home-card>
          <aside class="project-card__connections" aria-label={`${entry.data.title}와 연결된 공개 기록`}>
            <p>연결된 기록 지도</p>
            {(connectionsById[entry.id] ?? []).length > 0 ? (
              <ol class="project-card__path">
                {(connectionsById[entry.id] ?? []).map((connection) => (
                  <li class="project-card__path-step">
                    <span>{kindLabels[connection.kind]}</span>
                    <a href={withBase(connection.url)}>{connection.title}</a>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="project-card__connections-empty">연결된 공개 기록을 정리하고 있습니다.</p>
            )}
          </aside>
          <div class="project-card__content">
            <div class="project-card__meta">
              <span>{entry.data.status ? statusLabels[entry.data.status] ?? '상태 미정' : '상태 미정'}</span>
              <span>{categoryLabel(entry.data.category)}</span>
            </div>
            <h3><a href={withBase(entry.url)}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
            <ul aria-label="태그">
              {entry.data.tags.map((tag) => <li>#{tag}</li>)}
            </ul>
            <a class="project-card__action" href={withBase(entry.url)}>
              프로젝트의 선택과 근거 보기 <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="featured-projects__empty">아직 공개된 주요 프로젝트가 없습니다.</p>
  )}
</section>

<style>
  .home-section { padding-block-start: clamp(5rem, 9vw, 7.5rem); }
  .featured-projects__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block-end: clamp(2rem, 4vw, 3.5rem); }
  .featured-projects__heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 620; letter-spacing: -0.04em; line-height: 1.08; }
  .featured-projects__heading p { max-width: 40rem; margin: 0.8rem 0 0; color: var(--muted); }
  .featured-projects__heading > a { color: var(--primary); font-size: 0.9rem; font-weight: 650; text-decoration: none; white-space: nowrap; }

  .featured-projects__grid { display: grid; grid-auto-flow: dense; gap: 1rem; }

  .project-card {
    display: grid;
    min-height: 27rem;
    grid-template-columns: minmax(16rem, 5fr) minmax(0, 7fr);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .project-card__connections { display: flex; min-height: 20rem; flex-direction: column; justify-content: center; padding: clamp(2rem, 5vw, 4rem); background: var(--ink); color: var(--surface); }
  .project-card__connections > p:first-child { margin: 0; color: color-mix(in srgb, var(--surface) 62%, transparent); font-size: 0.75rem; font-weight: 650; }
  .project-card__connections ol { position: relative; display: grid; gap: 0; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .project-card__connections ol::before { position: absolute; inset-block: 1.5rem; inset-inline-start: 0.28rem; width: 1px; background: color-mix(in srgb, var(--signal) 55%, transparent); content: ''; }
  .project-card__connections li { position: relative; display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1rem; padding: 1.15rem 0 1.15rem 1.5rem; border-block-end: 1px solid color-mix(in srgb, var(--surface) 18%, transparent); }
  .project-card__connections li:first-child { border-block-start: 1px solid color-mix(in srgb, var(--surface) 18%, transparent); }
  .project-card__connections li::before { position: absolute; width: 0.58rem; height: 0.58rem; inset-block-start: 1.45rem; inset-inline-start: 0; border: 2px solid var(--ink); border-radius: 50%; background: var(--signal); box-shadow: 0 0 0 1px color-mix(in srgb, var(--signal) 70%, transparent); content: ''; }
  .project-card__connections li > span { color: var(--surface); font-size: 0.7rem; font-weight: 680; }
  .project-card__connections a { color: var(--surface); font-size: 0.9rem; font-weight: 580; line-height: 1.45; text-decoration: none; }
  .project-card__connections a:hover { color: var(--signal); }
  .project-card__connections-empty { margin: 1.5rem 0 0; color: color-mix(in srgb, var(--surface) 70%, transparent); }

  .project-card__content { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 6vw, 5rem); }
  .project-card__meta { display: flex; gap: 1rem; color: var(--primary); font-size: 0.75rem; font-weight: 650; }
  .project-card h3 { margin: 1.25rem 0 0; font-size: clamp(2rem, 5vw, 4.25rem); font-weight: 620; letter-spacing: -0.04em; line-height: 1; }
  .project-card h3 a { text-decoration: none; }
  .project-card h3 a:hover { color: var(--primary); }
  .project-card p { max-width: 38rem; margin: 1.5rem 0 0; color: var(--muted); font-size: 1rem; }
  .project-card ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 2rem 0 0; padding: 0; color: var(--muted); font-size: 0.78rem; list-style: none; }
  .project-card__action { width: fit-content; margin-block-start: 2rem; color: var(--primary); font-size: 0.86rem; font-weight: 650; text-decoration: none; }
  .featured-projects__empty { padding: 2rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--muted); }

  @media (max-width: 48rem) {
    .featured-projects__heading { align-items: start; flex-direction: column; }
    .project-card { grid-template-columns: minmax(0, 1fr); }
    .project-card__connections { min-height: 0; }
  }
</style>
