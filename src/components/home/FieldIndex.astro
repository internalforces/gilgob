---
import { withBase } from '../../config/site';
import type { ContentKind } from '../../lib/content/types';
import type { NormalizedEntry } from '../../lib/content/queries';
import { categoryLabel } from '../../lib/content/taxonomy';

interface Props {
  entries: NormalizedEntry[];
}

const { entries } = Astro.props;
const subjectRoutes: Array<{ category: string; kind: ContentKind; href: string }> = [
  { category: 'Computer Science', kind: 'knowledge', href: '/knowledge/?category=Computer%20Science' },
  { category: 'Data & Mathematics', kind: 'knowledge', href: '/knowledge/?category=Data%20%26%20Mathematics' },
  { category: 'AI', kind: 'explorations', href: '/explorations/?category=AI' },
  { category: 'Finance', kind: 'knowledge', href: '/knowledge/?category=Finance' },
  { category: 'Research', kind: 'explorations', href: '/explorations/?category=Research' },
];
const subjects = subjectRoutes
  .map(({ category, kind, href }) => ({
    label: categoryLabel(category),
    href,
    count: entries.filter((entry) => (
      entry.kind === kind && entry.data.category === category
    )).length,
  }))
  .filter((subject) => subject.count > 0);

---

<section class="field-index home-section" aria-labelledby="field-index-title">
  <header class="home-section__heading">
    <div>
      <h2 id="field-index-title">관심 주제로 넓혀가기</h2>
      <p>지금 기록이 있는 분야만 모았습니다. 한 주제를 골라 연결된 지식과 탐구를 살펴보세요.</p>
    </div>
    <a href={withBase('/knowledge/')}>전체 지식 보기 <span aria-hidden="true">→</span></a>
  </header>

  <div class="field-index__subjects" aria-label="기록이 있는 주제">
    {subjects.map((subject) => (
      <a href={withBase(subject.href)} data-home-card>
        <strong>{subject.label}</strong>
        <span>{subject.count.toLocaleString('ko-KR')}개의 기록</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M5 12h14M14 7l5 5-5 5"></path>
        </svg>
      </a>
    ))}
  </div>
</section>

<style>
  .home-section { padding-block-start: clamp(5rem, 9vw, 7.5rem); }
  .home-section__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block-end: clamp(2rem, 4vw, 3.5rem); }
  .home-section__heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 620; letter-spacing: -0.04em; line-height: 1.08; }
  .home-section__heading p { max-width: 40rem; margin: 0.8rem 0 0; color: var(--muted); }
  .home-section__heading > a { color: var(--primary); font-size: 0.9rem; font-weight: 650; text-decoration: none; white-space: nowrap; }

  .field-index__subjects { display: grid; max-width: 56rem; align-content: start; border-block-start: 1px solid var(--line); }
  .field-index__subjects > a { display: grid; min-height: 6.5rem; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 1.25rem; padding: 1.25rem 0; border-block-end: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .field-index__subjects strong { font-size: clamp(1.35rem, 2.6vw, 2.1rem); font-weight: 610; letter-spacing: -0.035em; }
  .field-index__subjects span { color: var(--muted); font-size: 0.82rem; }
  .field-index__subjects svg { color: var(--primary); transition: transform 180ms ease; }
  .field-index__subjects > a:hover svg { transform: translateX(0.35rem); }

  @media (max-width: 35rem) {
    .home-section__heading { align-items: start; flex-direction: column; }
    .field-index__subjects > a { grid-template-columns: minmax(0, 1fr) auto; }
    .field-index__subjects svg { display: none; }
  }
</style>
