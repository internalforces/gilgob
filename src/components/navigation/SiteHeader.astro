---
import { SITE_CONFIG, withBase } from '../../config/site';
import SearchTrigger from '../search/SearchTrigger.astro';
import MobileMenu from './MobileMenu';

const primaryNavigation = [
  { label: '지식', href: withBase('/knowledge/') },
  { label: '탐구', href: withBase('/explorations/') },
  { label: '프로젝트', href: withBase('/projects/') },
  { label: '학습 기록', href: withBase('/logs/') },
];
const utilityNavigation = [
  { label: '스킬 트리', href: withBase('/skills/') },
  { label: '지식 그래프', href: withBase('/graph/') },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === withBase('/') ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header" data-pagefind-ignore>
  <div class="site-container site-header__inner">
    <a class="site-header__identity" href={withBase('/')} aria-label="gilgob 홈">
      <span class="site-header__signal" aria-hidden="true"></span>
      <span>gilgob</span>
    </a>

    <nav class="site-header__nav" aria-label="주요 메뉴">
      <ul>
        {primaryNavigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="site-header__tools">
          <details>
            <summary>도구</summary>
            <ul>
              {utilityNavigation.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <SearchTrigger />
      <a
        class="site-header__icon-button"
        href={SITE_CONFIG.github}
        aria-label="GitHub 프로필 열기"
        target="_blank"
        rel="noreferrer"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 2.4a9.8 9.8 0 0 0-3.1 19.1c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.6 4.9.4.3.7.9.7 1.9V21c0 .3.2.6.7.5A9.8 9.8 0 0 0 12 2.4Z"></path>
        </svg>
      </a>
    </div>

    <MobileMenu
      client:load
      items={primaryNavigation.map((item) => ({ ...item, current: isCurrent(item.href) }))}
      utilityItems={utilityNavigation.map((item) => ({ ...item, current: isCurrent(item.href) }))}
      githubHref={SITE_CONFIG.github}
    />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 30;
    inset-block-start: 0;
    border-block-end: 1px solid color-mix(in srgb, var(--line) 78%, transparent);
    background: color-mix(in srgb, var(--canvas) 88%, transparent);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    position: relative;
    display: grid;
    min-height: 4.5rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3.5rem);
  }

  .site-header__identity {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .site-header__signal {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--signal) 16%, transparent);
  }

  .site-header__nav {
    min-width: 0;
  }

  .site-header__nav > ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.55rem, 1.2vw, 1.3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav > ul > li > a,
  .site-header__tools summary {
    position: relative;
    display: block;
    padding-block: 0.6rem;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 580;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .site-header__nav > ul > li > a::after,
  .site-header__tools summary::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.28rem;
    height: 1px;
    background: var(--primary);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .site-header__nav > ul > li > a:hover,
  .site-header__nav > ul > li > a[aria-current='page'],
  .site-header__tools summary:hover,
  .site-header__tools details[open] summary {
    color: var(--ink);
  }

  .site-header__nav > ul > li > a:hover::after,
  .site-header__nav > ul > li > a[aria-current='page']::after,
  .site-header__tools summary:hover::after,
  .site-header__tools details[open] summary::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__tools { position: relative; }
  .site-header__tools summary { list-style: none; cursor: pointer; }
  .site-header__tools summary::-webkit-details-marker { display: none; }
  .site-header__tools > details > ul {
    position: absolute;
    z-index: 40;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    display: grid;
    width: 10rem;
    gap: 0.15rem;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, var(--ink) 14%, transparent);
    list-style: none;
  }
  .site-header__tools > details:not([open]) > ul { display: none; }
  .site-header__tools a { display: block; padding: 0.65rem 0.75rem; border-radius: 0.5rem; color: var(--muted); font-size: 0.8rem; text-decoration: none; }
  .site-header__tools a:hover,
  .site-header__tools a[aria-current='page'] { background: color-mix(in srgb, var(--primary) 7%, var(--surface)); color: var(--primary); }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .site-header__icon-button {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    color: var(--muted);
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease;
  }

  .site-header__icon-button:hover {
    border-color: var(--line);
    background: var(--surface);
    color: var(--ink);
  }

  @media (max-width: 70rem) {
    .site-header__inner {
      gap: 1.25rem;
    }

    .site-header__nav > ul {
      gap: 0.65rem;
    }

    .site-header__nav > ul > li > a,
    .site-header__tools summary {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 52rem) {
    .site-header__inner {
      min-height: 4rem;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .site-header__nav,
    .site-header__actions {
      display: none;
    }
  }
</style>
