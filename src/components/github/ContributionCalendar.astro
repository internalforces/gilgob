---
import type { ContributionWeek } from '../../lib/github/types';

interface Props {
  total: number;
  weeks: ContributionWeek[];
}

const { total, weeks } = Astro.props;
const days = weeks.flatMap((week) => week.days);
const monthLabels = weeks.map((week, index) => {
  const firstDay = week.days[0];
  if (!firstDay) return '';
  const month = Number(firstDay.date.slice(5, 7));
  const previousDay = weeks[index - 1]?.days[0];
  const previousMonth = previousDay ? Number(previousDay.date.slice(5, 7)) : null;
  return index === 0 || month !== previousMonth ? `${month}월` : '';
});
const formatDayLabel = (date: string, count: number) => {
  const [year, month, day] = date.split('-').map(Number);
  return `${year}년 ${month}월 ${day}일, 기여 ${count}회`;
};
---

<section class="contribution-calendar" aria-labelledby="contribution-calendar-title">
  <header class="contribution-calendar__header">
    <div>
      <h3 id="contribution-calendar-title">지난 1년 기여</h3>
      <p><strong>{total.toLocaleString('ko-KR')}회</strong>의 공개 기여를 기록했습니다.</p>
    </div>
    <a href="https://github.com/internalforces" target="_blank" rel="noreferrer">
      기여 내역 보기 <span aria-hidden="true">↗</span>
    </a>
  </header>

  {weeks.length > 0 && days.length > 0 ? (
    <div class="contribution-calendar__viewport" tabindex="0" aria-label="기여 캘린더 가로 스크롤 영역">
      <div class="contribution-calendar__plot" style={`--calendar-weeks: ${weeks.length}`}>
        <div class="contribution-calendar__months" aria-hidden="true">
          {monthLabels.map((label) => <span>{label}</span>)}
        </div>
        <div class="contribution-calendar__weeks" role="group" aria-label={`지난 1년 GitHub 기여 합계 ${total}회`}>
          {weeks.map((week) => (
            <div class="contribution-calendar__week">
              {week.days.map((day) => (
                <span
                  class={`contribution-calendar__day contribution-calendar__day--${day.level}`}
                  style={`grid-row: ${new Date(`${day.date}T00:00:00.000Z`).getUTCDay() + 1}`}
                  role="img"
                  aria-label={formatDayLabel(day.date, day.count)}
                ></span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <p class="contribution-calendar__empty">표시할 기여 캘린더가 없습니다.</p>
  )}

  <div class="contribution-calendar__legend" aria-label="기여 강도 범례">
    <span>적음</span>
    {[0, 1, 2, 3, 4].map((level) => (
      <span class={`contribution-calendar__legend-cell contribution-calendar__day--${level}`} aria-hidden="true"></span>
    ))}
    <span>많음</span>
  </div>

  <table class="contribution-calendar__table">
    <caption>날짜별 GitHub 기여 횟수</caption>
    <thead><tr><th scope="col">날짜</th><th scope="col">기여 횟수</th></tr></thead>
    <tbody>
      {days.map((day) => <tr><th scope="row">{day.date}</th><td>{day.count}회</td></tr>)}
    </tbody>
  </table>
</section>

<style>
  .contribution-calendar { min-width: 0; padding: clamp(1.4rem, 3vw, 2rem); border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent); border-radius: var(--radius); background: var(--surface); color: var(--ink); }
  .contribution-calendar__header { display: flex; align-items: start; justify-content: space-between; gap: 1.5rem; margin-block-end: 1.75rem; }
  .contribution-calendar h3 { margin: 0; font-size: 1.05rem; font-weight: 650; letter-spacing: -0.025em; }
  .contribution-calendar__header p { margin: 0.35rem 0 0; color: var(--muted); font-size: 0.82rem; }
  .contribution-calendar__header strong { color: var(--ink); font-size: 1rem; }
  .contribution-calendar__header a { color: var(--primary); font-size: 0.78rem; font-weight: 650; text-decoration: none; white-space: nowrap; }
  .contribution-calendar__viewport { overflow-x: auto; padding-block-end: 0.65rem; direction: rtl; scrollbar-color: color-mix(in srgb, var(--muted) 38%, transparent) transparent; scrollbar-width: thin; }
  .contribution-calendar__viewport:focus-visible { border-radius: 0.25rem; }
  .contribution-calendar__plot { min-width: max(42rem, calc(var(--calendar-weeks) * 0.78rem)); direction: ltr; }
  .contribution-calendar__months,
  .contribution-calendar__weeks { display: grid; grid-template-columns: repeat(var(--calendar-weeks), minmax(0, 1fr)); gap: 0.2rem; }
  .contribution-calendar__months { margin-block-end: 0.45rem; color: var(--muted); font-size: 0.66rem; line-height: 1; }
  .contribution-calendar__months span { min-width: 0; white-space: nowrap; }
  .contribution-calendar__week { display: grid; grid-template-rows: repeat(7, 0.58rem); gap: 0.2rem; }
  .contribution-calendar__day,
  .contribution-calendar__legend-cell { display: block; width: 100%; min-width: 0.58rem; border-radius: 2px; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 5%, transparent); }
  .contribution-calendar__day--0 { background: #edf1f5; }
  .contribution-calendar__day--1 { background: #c9f0df; }
  .contribution-calendar__day--2 { background: #7dd3a7; }
  .contribution-calendar__day--3 { background: #37c998; }
  .contribution-calendar__day--4 { background: #167c61; }
  .contribution-calendar__legend { display: flex; align-items: center; justify-content: end; gap: 0.32rem; margin-block-start: 0.65rem; color: var(--muted); font-size: 0.66rem; }
  .contribution-calendar__legend-cell { width: 0.58rem; height: 0.58rem; }
  .contribution-calendar__empty { min-height: 7rem; display: grid; place-items: center; color: var(--muted); font-size: 0.82rem; }
  .contribution-calendar__table { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 36rem) { .contribution-calendar__header { align-items: start; flex-direction: column; } }
</style>
