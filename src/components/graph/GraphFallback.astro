---
import { withBase } from '../../config/site';
import type { ContentRecord } from '../../lib/content/types';
import { categoryLabel } from '../../lib/content/taxonomy';

interface Props {
  documents: ContentRecord[];
}

const { documents } = Astro.props;
const sortedDocuments = [...documents].sort((left, right) => left.title.localeCompare(right.title, 'ko'));
const documentById = new Map(sortedDocuments.map((document) => [document.id, document]));
const connections = (ids: string[]) => ids
  .map((id) => documentById.get(id))
  .filter((document): document is ContentRecord => document !== undefined)
  .sort((left, right) => left.title.localeCompare(right.title, 'ko'));
const taxonomyId = (kind: 'category' | 'tag', value: string) => `${kind}-${encodeURIComponent(value)}`;
const taxonomyHref = (kind: 'category' | 'tag', value: string) => withBase(`/graph/#${taxonomyId(kind, value)}`);
const groupedDocuments = (valuesFor: (document: ContentRecord) => string[]) => {
  const groups = new Map<string, ContentRecord[]>();
  for (const document of sortedDocuments) {
    for (const value of new Set(valuesFor(document))) {
      groups.set(value, [...(groups.get(value) ?? []), document]);
    }
  }
  return [...groups.entries()].sort(([left], [right]) => left.localeCompare(right, 'ko'));
};
const categoryGroups = groupedDocuments((document) => [document.category]);
const tagGroups = groupedDocuments((document) => document.tags);
---

<details class="graph-fallback" aria-label="그래프 대신 목록 보기" open>
  <summary>그래프 대신 목록 보기</summary>
  <div class="graph-fallback__intro">
    <h2>모든 공개 문서와 연결</h2>
    <p>시각 그래프와 같은 문서를 일반 링크로 탐색할 수 있습니다.</p>
  </div>
  <ol class="graph-fallback__documents">
    {sortedDocuments.map((document) => (
      <li>
        <article>
          <header>
            <p>
              <a href={taxonomyHref('category', document.category)}>
                분야: {categoryLabel(document.category)}
              </a>
            </p>
            <h3><a href={withBase(document.url)}>{document.title}</a></h3>
            <span>{document.description}</span>
            <ul class="graph-fallback__tags" aria-label={`${document.title} 태그`}>
              {document.tags.map((tag) => (
                <li><a href={taxonomyHref('tag', tag)}>#{tag}</a></li>
              ))}
            </ul>
          </header>
          <div class="graph-fallback__relations">
            <div>
              <h4 id={`outgoing-${document.id}`}>나가는 연결</h4>
              {connections(document.outgoing).length > 0 ? (
                <ul>
                  {connections(document.outgoing).map((target) => (
                    <li><a href={withBase(target.url)}>{target.title}</a></li>
                  ))}
                </ul>
              ) : <p>연결 없음</p>}
            </div>
            <div>
              <h4 id={`incoming-${document.id}`}>들어오는 연결</h4>
              {connections(document.backlinks).length > 0 ? (
                <ul>
                  {connections(document.backlinks).map((source) => (
                    <li><a href={withBase(source.url)}>{source.title}</a></li>
                  ))}
                </ul>
              ) : <p>연결 없음</p>}
            </div>
          </div>
        </article>
      </li>
    ))}
  </ol>
  <div class="graph-fallback__taxonomy">
    <section aria-labelledby="graph-categories-title">
      <h2 id="graph-categories-title">분야별 공개 문서</h2>
      <ul>
        {categoryGroups.map(([category, entries]) => (
          <li>
            <h3 id={taxonomyId('category', category)}>분야: {categoryLabel(category)}</h3>
            <ul>
              {entries.map((entry) => <li><a href={withBase(entry.url)}>{entry.title}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="graph-tags-title">
      <h2 id="graph-tags-title">태그별 공개 문서</h2>
      <ul>
        {tagGroups.map(([tag, entries]) => (
          <li>
            <h3 id={taxonomyId('tag', tag)}>태그: #{tag}</h3>
            <ul>
              {entries.map((entry) => <li><a href={withBase(entry.url)}>{entry.title}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  </div>
</details>
