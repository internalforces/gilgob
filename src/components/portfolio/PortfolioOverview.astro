---
import type { CollectionEntry } from 'astro:content';
import { PORTFOLIO_PROFILE } from '../../config/portfolio';
import PortfolioMiniGraphic from './PortfolioMiniGraphic.astro';

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const story = [
  { label: '문제', copy: entry.data.story.problem },
  { label: '방식', copy: entry.data.story.approach },
  { label: '결과', copy: entry.data.story.result },
];
---

<section class="portfolio-screen portfolio-overview" aria-labelledby="portfolio-overview-title">
  <header class="portfolio-frame__header">
    <div>
      <p class="portfolio-frame__identity">{PORTFOLIO_PROFILE.name}</p>
      <p>{entry.data.targetRole}</p>
      <p class="portfolio-frame__domains">
        관련 분야 · <strong>{entry.data.targetDomains.primary}</strong> ·
        {entry.data.targetDomains.subdomains.join(' · ')}
      </p>
    </div>
    <p class="portfolio-frame__marker">프로젝트 개요</p>
  </header>

  <h1 id="portfolio-overview-title">{entry.data.headline}</h1>

  <dl class="portfolio-metrics" aria-label="프로젝트 핵심 지표">
    {entry.data.metrics.map((metric) => (
      <div>
        <dt>{metric.label}</dt>
        <dd>{metric.value}</dd>
        <dd class="portfolio-metrics__detail">{metric.detail}</dd>
      </div>
    ))}
  </dl>

  <section class="portfolio-section" aria-labelledby="portfolio-story-title">
    <h2 id="portfolio-story-title">왜 만들었고, 어떻게 풀었나</h2>
    <div class="portfolio-story">
      {story.map((item, index) => (
        <article class="portfolio-story__card">
          <p class="portfolio-card__index">0{index + 1}</p>
          <h3>{item.label}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="portfolio-section" aria-labelledby="portfolio-capabilities-title">
    <h2 id="portfolio-capabilities-title">구현한 기능</h2>
    <div class="portfolio-capabilities">
      {entry.data.capabilities.map((capability) => (
        <article class:list={['portfolio-capability', { 'portfolio-capability--with-visual': capability.visual }]}>
          <PortfolioMiniGraphic visual={capability.visual} />
          <div class="portfolio-capability__copy">
            <h3>{capability.title}</h3>
            <p>{capability.summary}</p>
            <p class="portfolio-capability__evidence">근거 · {capability.evidence}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="portfolio-ownership" aria-labelledby="portfolio-ownership-title">
    <h2 id="portfolio-ownership-title">직접 구현한 범위</h2>
    <ul>
      {entry.data.ownership.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <footer class="portfolio-frame__footer">
    <a href={`mailto:${PORTFOLIO_PROFILE.email}`}>{PORTFOLIO_PROFILE.email}</a>
    <p>1 / 2 · 프로젝트 개요</p>
  </footer>
</section>
